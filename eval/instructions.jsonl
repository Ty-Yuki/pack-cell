{"id": "a02", "cat": "alias", "text": "ミネラルウォーター2本と絹豆腐。", "items": {"water": 2, "tofu": 1}, "constraints": [], "expect": "ok"}
{"id": "a03", "cat": "alias", "text": "ミルクとアイスクリームとスナック菓子。", "items": {"milk": 1, "ice": 1, "chips": 1}, "constraints": [], "expect": "ok"}
{"id": "a04", "cat": "alias", "text": "食パン1斤とサバ缶2つ、それからバナナ。", "items": {"bread": 1, "canned": 2}, "constraints": [], "expect": "ok", "unknown": ["バナナ"]}
