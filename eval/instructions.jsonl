{"id": "c03", "cat": "conflict", "text": "食パンの上に米を載せてください。", "items": {"bread": 1, "rice": 1}, "constraints": [["on", ["rice", "bread"]]], "expect": "clarify"}
{"id": "c04", "cat": "conflict", "text": "水を5本と米を4つ、1箱にお願いします。", "items": {"water": 5, "rice": 4}, "constraints": [], "expect": "clarify"}
{"id": "c05", "cat": "conflict", "text": "洗剤を豆腐の上に載せて。", "items": {"detergent": 1, "tofu": 1}, "constraints": [["on", ["detergent", "tofu"]]], "expect": "clarify"}
